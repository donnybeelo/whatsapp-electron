{
	"name": "whatsapp",
	"productName": "WhatsApp",
	"desktopName": "WhatsApp",
	"version": "1.3.4",
	"description": "An unofficial WhatsApp desktop client built with Electron.",
	"author": "Daniel Elia (donnybeelo)",
	"license": "ISC",
	"main": "./src/index.js",
	"scripts": {
		"start": "electron ./src",
		"clean": "rm -rf ./dist",
		"pack": "electron-builder --dir",
		"dist": "electron-builder",
		"dist:linux": "electron-builder --linux --x64",
		"dist:windows": "electron-builder --windows --x64"
	},
	"build": {
		"linux": {
			"appId": "whatsapp",
			"desktop": {
				"entry": {
					"StartupWMClass": "whatsapp"
				}
			},
			"icon": "./assets/whatsapp-icon-512x512.png",
			"category": "Network",
			"target": [
				"AppImage"
			],
			"asarUnpack": [
				"**/assets/*.svg",
				"**/assets/*.png"
			]
		},
		"win": {
			"appId": "whatsapp",
			"icon": "./assets/whatsapp-icon-512x512.png",
			"target": [
				"portable",
				"zip"
			],
			"signAndEditExecutable": false,
			"asarUnpack": [
				"**/assets/*.svg",
				"**/assets/*.png"
			]
		}
	},
	"dependencies": {
		"electron-store": "^8.2.0"
	},
	"devDependencies": {
		"electron": "^39.2.1",
		"electron-builder": "^26.0.12"
	}
}
